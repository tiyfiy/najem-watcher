{
  "name": "najem-watcher",
  "version": "1.0.0",
  "private": true,
  "description": "Opozorilnik za nove najemniske oglase v Ljubljani (Telegram push).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "once": "tsx src/index.ts --once",
    "dump": "tsx src/tools/dump.ts",
    "test-notify": "tsx src/tools/test-notify.ts",
    "fb:login": "tsx src/tools/fb-login.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "nodemailer": "^6.9.14",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^6.4.15",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
